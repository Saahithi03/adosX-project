# Copy to .env:  cp .env.example .env
# Read by docker compose (the POSTGRES_* / DEALEROS_*_PASSWORD lines) and by
# Django (everything else). Local-dev values only; .env is git-ignored.

# --- Postgres container (used only by docker/postgres/init/01-roles.sh) ---
POSTGRES_PASSWORD=postgres_dev_pw
DEALEROS_OWNER_PASSWORD=owner_dev_pw
DEALEROS_APP_PASSWORD=app_dev_pw

# --- Django connections. Passwords must match the two lines above. ---
# Owner: migrations, seed, ingest. Selected only via DEALEROS_DB_ROLE=owner.
DATABASE_URL_OWNER=postgres://dealeros_owner:owner_dev_pw@localhost:5433/dealeros
# App: web server and tests. Not an owner or superuser, so RLS applies.
DATABASE_URL_APP=postgres://dealeros_app:app_dev_pw@localhost:5433/dealeros

# --- Django ---
DJANGO_SECRET_KEY=dev-only-not-a-secret-change-me
DJANGO_DEBUG=1

# --- LLM (optional: without it /api/ask refuses LLM_UNAVAILABLE) ---
# Google AI Studio key (free tier): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ASK_MODEL=gemini-3.1-flash-lite
